{#- Per-site nginx vhost.

    certbot runs in `certonly --webroot` mode, so it never edits this file --
    the SSL server block below is rendered by the panel from the site's own
    state. That keeps this file something the panel can rebuild at any time.
-#}
# {{ banner }}
# Site: {{ site.name }} ({{ site.domain }})

{% macro serve() %}
    root {{ site.webroot }};
    index index.php index.html index.htm;

    access_log /var/log/nginx/{{ site.name }}.access.log;
    error_log  /var/log/nginx/{{ site.name }}.error.log;

    client_max_body_size {{ site.upload_limit_mb }}M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|webp|avif|woff|woff2|ttf|eot|pdf|zip)$ {
        try_files $uri =404;
        expires max;
        access_log off;
    }

{% if fpm_socket %}
    location ~ \.php$ {
        # snippets/fastcgi-php.conf (stock on Debian/Ubuntu) already sets its
        # own try_files against $fastcgi_script_name after splitting PATH_INFO
        # -- nginx rejects a second try_files in the same location outright,
        # so one must never be added here too.
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{ fpm_socket }};
        fastcgi_read_timeout 300;
    }
{% else %}
    # No PHP version assigned to this site; .php files are not executed.
    location ~ \.php$ {
        return 404;
    }
{% endif %}

    # Dotfiles are configuration and version-control data, never content --
    # except the ACME challenge directory, which must stay reachable.
    location ~ /\.(?!well-known) {
        deny all;
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # User-editable override — managed by lite-panel config editor.
    # Add custom nginx directives (e.g. rewrites, extra headers, cache rules).
    # This file is never overwritten by the panel; only you control its content.
    include /etc/nginx/custom/lite-panel-{{ site.name }}-custom.conf;
{% endmacro %}

{% if site.redirect_www %}
server {
    listen 80;
    listen [::]:80;
    server_name www.{{ site.domain }};

    location /.well-known/acme-challenge/ {
        root {{ acme_root }};
    }

    location / {
        return 301 http{% if site.ssl_enabled %}s{% endif %}://{{ site.domain }}$request_uri;
    }
}
{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ server_names | join(' ') }};

    location /.well-known/acme-challenge/ {
        root {{ acme_root }};
    }

{% if site.ssl_enabled %}
    location / {
        return 301 https://{{ site.domain }}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ server_names | join(' ') }};

    ssl_certificate     /etc/letsencrypt/live/{{ site.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site.domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

{{ serve() }}
}
{% else %}
{{ serve() }}
}
{% endif %}
