# {{ banner }}
# Site: {{ site.name }} ({{ site.domain }}) -- {{ runtime }} application
[Unit]
Description=lite-panel {{ runtime }} app for {{ site.domain }}
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User={{ site.system_user }}
Group={{ site.system_user }}
WorkingDirectory={{ workdir }}
Environment="HOME={{ site.root_dir }}"
Environment="PORT={{ port }}"
Environment="HOST=127.0.0.1"
Environment="PATH={{ path_env }}"
{% for key, value in base_env %}
Environment="{{ key }}={{ value }}"
{% endfor %}
EnvironmentFile=-{{ env_file }}
ExecStart=/bin/bash -c "{{ exec_start }}"
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lite-panel-app-{{ site.name }}

[Install]
WantedBy=multi-user.target
